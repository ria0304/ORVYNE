# ===========================================
# WYA — What's Your Aesthetic
# ===========================================

# ── Environment ───────────────────────────
DEBUG=false
NODE_ENV=production

# ── JWT ───────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── App URL ───────────────────────────────
# Local development
WYA_APP_BASE_URL=http://127.0.0.1:8000
# Production: set via EXTRA_ORIGINS environment variable

# ── AI / ML APIs ──────────────────────────
OPENROUTER_API_KEY=
HF_TOKEN=

# ── Geolocation ───────────────────────────
GEOAPIFY_API_KEY=

# ── Email (Gmail SMTP) ────────────────────
WYA_GMAIL_ADDRESS=wya123@gmail.com
WYA_GMAIL_APP_PASS=

# ── Push Notifications (VAPID) ────────────
# These are optional; setup guide available in /services/email_service.py
WYA_VAPID_PUBLIC_KEY=
WYA_VAPID_PRIVATE_KEY=

# ── Extra CORS Origins (optional, comma-separated) ────────────────────────────
# EXTRA_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173