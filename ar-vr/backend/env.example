# ar-vr Integration Layer — Environment Variables
# Copy this file to .env and adjust values for your environment.

# ===== Service URLs (existing projects) =====
# BATISSE — Floor plan to 3D dollhouse
BATISSE_BASE_URL=http://127.0.0.1:8000

# WYA — AI-powered wardrobe intelligence
WYA_BASE_URL=http://127.0.0.1:8000

# TryOn — Virtual clothing try-on
TRYON_BASE_URL=http://127.0.0.1:8000

# VELARIS — AI-powered jewellery design
VELARIS_BASE_URL=http://127.0.0.1:8000

# ===== Integration Layer =====
APP_NAME=ar-vr-integration
APP_VERSION=0.1.0
DEBUG=true

# Central JWT secret for service-to-service tokens
# Change this for production; keep secret safe
INTEGRATION_JWT_SECRET=ar-vr-dev-secret-change-in-production

# ===== Database =====
# Shared integration database — SQLite for development, PostgreSQL for production
DATABASE_URL=sqlite:///./arvr_integration.db

# ===== CORS =====
# Frontend origins that can call the integration API
# Add/remove origins as needed for your deployment
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== WYA Specific =====
# WYA backend URL (local development or production)
WYA_APP_BASE_URL=http://127.0.0.1:8000

# Allowed origins for WYA auth callbacks
ALLOWED_ORIGINS=http://localhost:5173

# ===== Velaris Model Fallback Chain =====
# Default LLM model chain for jewellery design advice
DEFAULT_MODEL_CHAIN=["google/gemini-2.0-flash-lite","meta-llama/llama-3.2-3b-instruct","mistralai/mistral-7b-instruct","google/gemini-2.5-flash"]

# ===== Asset Directories =====
# Directories for 3D assets, models, and textures
ASSETS_DIR=str(__file__.replace("/config.py","/assets"))
MODELS_DIR=str(__file__.replace("/config.py","/assets/models"))
TEXTURES_DIR=str(__file__.replace("/config.py","/assets/textures"))
